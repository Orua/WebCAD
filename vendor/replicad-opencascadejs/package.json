{
  "name": "replicad-opencascadejs",
  "version": "1.1.0-webcad.1",
  "description": "Replicad OCCT 8.0.1 single-threaded build with complete ThruSections status binding",
  "author": "Steve Genoud <steve@sgenoud.com>",
  "license": "LGPL-2.1-only",
  "type": "module",
  "main": "./dist/replicad_single.cjs",
  "module": "./dist/replicad_single.js",
  "types": "./dist/replicad_single.d.ts",
  "exports": {
    ".": {"types": "./dist/replicad_single.d.ts", "import": "./dist/replicad_single.js", "require": "./dist/replicad_single.cjs", "default": "./dist/replicad_single.js"},
    "./wasm": "./dist/replicad_single.wasm",
    "./multi": {"types": "./dist/replicad_multi.d.ts", "import": "./dist/replicad_multi.js", "require": "./dist/replicad_multi.cjs", "default": "./dist/replicad_multi.js"},
    "./multi/wasm": "./dist/replicad_multi.wasm",
    "./package.json": "./package.json"
  },
  "files": ["dist", "LICENSE", "README.md"]
}
