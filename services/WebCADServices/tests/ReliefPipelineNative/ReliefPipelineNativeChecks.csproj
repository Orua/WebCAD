<Project Sdk="Microsoft.NET.Sdk">
  <!-- Cross-platform check of the relief Services pipeline (261022-04).
       Compiles the real Contracts/Runtime sources for net8.0 so it can run on Linux CI/box.
       Windows-only pieces are replaced by test doubles in TestDoubles.cs: WorkerSupervisor
       (Job Objects/CreateProcess) and the Logo adapter (LogoVector is not part of this check).
       The production net48 build is unchanged. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS8632;CS0618;SYSLIB0021;SYSLIB0023</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs;TestDoubles.cs;DevHost.cs" />
    <Compile Include="../../src/WebCADServices.Contracts/*.cs" />
    <Compile Include="../../src/WebCADServices.Runtime/*.cs" Exclude="../../src/WebCADServices.Runtime/WorkerSupervisor.cs" />
    <EmbeddedResource Include="../../../../contracts/services/v1/execution-routing.json" LogicalName="WebCADServices.ExecutionRouting.json" />
    <EmbeddedResource Include="../../../../contracts/services/v1/tbd-capabilities.json" LogicalName="WebCADServices.TbdCapabilities.json" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.8" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
  </ItemGroup>
</Project>
