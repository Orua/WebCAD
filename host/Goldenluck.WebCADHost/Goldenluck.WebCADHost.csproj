<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AssemblyName>Goldenluck.WebCADHost</AssemblyName>
    <RootNamespace>Goldenluck.WebCAD.Hosting</RootNamespace>
    <BaseIntermediateOutputPath>$(BuildRoot)/obj/Goldenluck.WebCADHost/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(BuildRoot)/bin/Goldenluck.WebCADHost/</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Configuration" />
    <Reference Include="BLL"><HintPath>$(HostReferenceDirectory)/BLL.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="DAL"><HintPath>$(HostReferenceDirectory)/DAL.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Main"><HintPath>$(HostReferenceDirectory)/Main.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Model"><HintPath>$(HostReferenceDirectory)/Model.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ChatClass"><HintPath>$(HostReferenceDirectory)/ChatClass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(HostReferenceDirectory)/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BouncyCastle.Cryptography"><HintPath>$(HostReferenceDirectory)/BouncyCastle.Cryptography.dll</HintPath><Private>false</Private></Reference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="RequireHostReferences" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(HostReferenceDirectory)' == '' or '$(BuildRoot)' == ''" Text="Supply HostReferenceDirectory (installed integration libraries) and an external BuildRoot. Web.dll and external source checkouts are not used." />
  </Target>
</Project>
