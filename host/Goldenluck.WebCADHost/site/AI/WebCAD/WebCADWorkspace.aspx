<%@ Page Language="C#" AutoEventWireup="true" Inherits="Goldenluck.WebCAD.Hosting.WebCADWorkspace, Goldenluck.WebCADHost" EnableSessionState="false" %>
<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>WebCAD 工作台</title><link rel="stylesheet" href="../agent-workbench.css?v=20261014-paste1"><link rel="stylesheet" href="../agent-theme.css?v=20261022-bubbles1"><link rel="stylesheet" href="webcad-workspace.css?v=20261022-compact1"><link rel="stylesheet" href="assistant-panel.css?v=20261024-robot1"><link rel="stylesheet" href="../agent-task-controls.css?v=20261022-hidecommands1"></head>
<body class="gl-workbench gl-cad"><link rel="stylesheet" href="../agent-voice.css?v=20261024-3"><main><section class="cad"><div class="viewport"><iframe id="cad-frame" title="WebCAD"></iframe><div id="edit-lock" hidden><div class="control-notice"><span>Agent 正在操作当前工程</span><small>关闭提示后可旋转、平移、缩放查看；编辑仍锁定</small><button id="dismiss-lock" type="button">查看模型</button></div></div></div></section>
<aside id="assistant-panel"><button id="assistant-panel-toggle" class="assistant-panel-toggle" type="button" title="收起 CAD 助手" aria-label="收起 CAD 助手" aria-expanded="true" aria-controls="assistant-panel"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 4v16M14 8l-4 4 4 4"/></svg></button><div class="assistant-heading"><h1>CAD 助手</h1><nav aria-label="Agent 连接与控制"><span id="connection" class="connection" role="status" tabindex="0" title="使用现有 GL Agent"></span><span id="status" class="sr-only" role="status">等待工程加载</span><button id="reconnect" class="icon-button" type="button" title="连接／重新验证当前工程" aria-label="连接当前工程"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-2 2M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l2-2"/></svg></button><button id="takeover" class="icon-button" type="button" title="退出 Agent，恢复编辑" aria-label="退出 Agent，恢复编辑"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 3 7 18 3-7 7-3L4 3Zm10 11 5 5"/></svg></button></nav></div><div id="messages" aria-live="polite"></div>
<form id="chat"><textarea id="prompt" aria-label="操作当前工程" rows="3" placeholder="告诉助手需要怎样修改…"></textarea><small id="attachment-status" hidden></small>
<footer><label class="attachment-input icon-button" title="添加参考文件" aria-label="添加参考文件"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 17 17 9a3 3 0 0 0-4-4L5 13a5 5 0 0 0 7 7l8-8M8 15l8-8"/></svg><input id="attachments" type="file" multiple accept=".step,.stp,.brep,.brp,.svg,.dxf,.dwg,.png,.jpg,.jpeg,.relief.json"></label><div class="effort-control"><input id="effort" type="range" min="0" max="2" step="1" value="1" aria-label="思考强度：快速、标准、深入"><output id="effort-label" for="effort">标准</output></div><button id="send" type="submit" class="icon-button" aria-label="发送" title="发送 · Ctrl+Enter">↑</button></footer></form></aside></main>
<script id="webcad-config" type="application/json"><%= BootstrapJson %></script>
<script src="../agent-workbench.js?v=20261021-byte-attach1"></script>
<script src="runtime-uuid.js?v=20261026-isolated"></script>
<script src="../agent-voice.js?v=20261024-3"></script>
<script src="../agent-guidance.js?v=20261024-voice1"></script>
<script type="module" src="webcad-workspace.js?v=20261026-isolated"></script></body></html>
