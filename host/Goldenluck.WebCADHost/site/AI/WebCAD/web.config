<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <!-- Transport ceiling only: the gateway independently enforces JSON and typed CAD file budgets. -->
    <httpRuntime maxRequestLength="525312" executionTimeout="150" />
  </system.web>
  <system.webServer>
    <handlers>
      <add name="WebCADComputeOptions" path="WebCADCompute.ashx" verb="OPTIONS" type="System.Web.UI.SimpleHandlerFactory" resourceType="File" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
    <security><requestFiltering><requestLimits maxAllowedContentLength="537919488" /></requestFiltering></security>
  </system.webServer>
</configuration>
