    "RELIEF_DESIGN_SUPPORT_INVALID",
    "RELIEF_DESIGN_MASK_BLOCKED",
    "RELIEF_DESIGN_NATIVE_REQUIRED",
    "STALE_REFERENCE",
    "INSTANCE_MISMATCH",
    "REVISION_CONFLICT",
    "PARAM_SCHEMA_INVALID",
    "CAPABILITY_UNAVAILABLE"
  ],
  "docs": "api.relief",
  "argumentKeys": [
    "context",
    "designId",
    "expectedDraftRevision",
    "target",
    "placement",
    "datum",
    "machiningIntent"
  ],
  "unknownFields": "rejected",
  "units": {
    "length": "mm"
  },
  "relatedTools": [
    "reliefDesignFit",
