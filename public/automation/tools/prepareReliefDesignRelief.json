  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "context",
      "designId",
      "expectedDraftRevision",
      "target"
    ],
    "properties": {
      "context": {
        "type": "object"
      },
      "designId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "expectedDraftRevision": {
        "type": "integer",
        "minimum": 1
      },
      "target": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bodyId",
          "faceId"
        ],
        "properties": {
          "bodyId": {
            "type": "string",
            "minLength": 1
          },
          "faceId": {
            "type": "integer",
            "minimum": 0
          },
          "expectedSourceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "placement": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "xDirection"
        ],
        "properties": {
          "originMm": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "alignTo": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "edgeIndex"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "const": "circularEdge"
              },
              "edgeIndex": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "xDirection": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        }
      },
      "datum": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "baselineMm"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "const": "authoredBaselineOnSelectedFace"
          },
          "baselineMm": {
            "type": "number"
          }
        }
      },
      "machiningIntent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "requestedGeometry",
          "sourceInterpretation",
          "userIntentEvidence"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "const": 1
          },
          "requestedGeometry": {
            "type": "string",
            "enum": [
              "constantDepthContours",
              "layeredRelief",
              "continuousRelief",
              "mixed",
              "unspecified"
            ]
          },
          "sourceInterpretation": {
            "type": "string",
            "enum": [
              "reviewedVectors",
              "rasterArtwork",
              "authoredHeightMap",
              "shadedReference",
              "sculptMesh"
            ]
          },
          "userIntentEvidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "sourceHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "direction": {
            "type": "string",
            "enum": [
              "emboss",
              "engrave"
            ]
          },
          "dimensionsMm": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width",
              "height"
            ],
            "properties": {
              "width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100000
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100000
              }
            }
          },
          "specifiedDepthsMm": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100000
            }
          },
          "targetPeakMm": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100000
          },
          "preserve": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "supportBinding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bodyId",
              "geometryFingerprint"
            ],
            "properties": {
              "bodyId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 150
              },
              "geometryFingerprint": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          },
          "placementSnapshot": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "origin",
              "quaternion"
            ],
            "properties": {
              "origin": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "quaternion": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  },
  "executionPolicy": {
    "readOnly": true,
    "geometryComputed": false,
    "previewStarted": false,
    "fallbackAllowed": false
  },
