        "quantizationPolicy": "none"
      },
      "scope": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "point"
              },
              "pointMm": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                },
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": [
              "kind",
              "pointMm"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "region"
              },
              "pointsMm": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -10000,
                    "maximum": 10000
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "minItems": 3,
                "maxItems": 32,
                "description": "Ordered vertices picked on the same face; the loop closes automatically"
              }
            },
            "required": [
              "kind",
              "pointsMm"
            ]
          }
        ]
      },
      "direction": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "normal"
              }
            },
            "required": [
              "kind"
            ],
            "unit": "1",
            "quantityKind": "direction",
            "quantizationPolicy": "none"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "angled"
              },
              "tiltDeg": {
                "type": "number",
                "minimum": 0,
                "maximum": 90,
                "description": "Tilt away from the outward face normal"
              },
              "azimuthDeg": {
                "type": "number",
                "minimum": -360,
                "maximum": 360,
                "description": "Azimuth from the U tangent towards normal cross U"
              }
            },
            "required": [
              "kind",
              "tiltDeg",
              "azimuthDeg"
            ],
            "unit": "1",
            "quantityKind": "direction",
            "quantizationPolicy": "none"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "vector"
              },
