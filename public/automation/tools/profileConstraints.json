                  "minLength": 1,
                  "maxLength": 64
                },
                "type": {
                  "type": "string",
                  "const": "coincident"
                },
                "first": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "entityId",
                    "point"
                  ],
                  "properties": {
                    "entityId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,64}$",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "point": {
                      "type": "string",
                      "enum": [
                        "start",
                        "end",
                        "center"
                      ]
                    }
                  }
                },
                "second": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "entityId",
                    "point"
                  ],
                  "properties": {
                    "entityId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,64}$",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "point": {
                      "type": "string",
                      "enum": [
                        "start",
                        "end",
                        "center"
                      ]
                    }
                  }
                }
              },
              "description": "Coincide two line endpoints or circle centers."
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "entityId"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$",
                  "minLength": 1,
                  "maxLength": 64
                },
                "type": {
                  "type": "string",
                  "const": "horizontal"
                },
                "entityId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "description": "Set a line parallel to the local X axis; never collapse its endpoints."
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "entityId"
              ],
              "properties": {
                "id": {
                  "type": "string",
