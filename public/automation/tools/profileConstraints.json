{
  "id": "profileConstraints",
  "version": "1.0.0",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "constraints"
    ],
    "properties": {
      "constraints": {
        "type": "array",
        "minItems": 0,
        "maxItems": 128,
        "description": "Line/circle constraints in saved local 2D mm coordinates. IDs refer to existing entities, never topology indices. An empty array only diagnoses remaining degrees of freedom.",
        "items": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "point",
                "positionMm"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$",
                  "minLength": 1,
                  "maxLength": 64
                },
                "type": {
                  "type": "string",
                  "const": "fixPoint"
                },
                "point": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "entityId",
                    "point"
                  ],
                  "properties": {
                    "entityId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,64}$",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "point": {
                      "type": "string",
                      "enum": [
                        "start",
                        "end",
                        "center"
                      ]
                    }
                  }
                },
                "positionMm": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "minimum": -1000000,
                    "maximum": 1000000
                  }
                }
              },
              "description": "Fix one endpoint or circle center to explicit local coordinates."
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "entityId"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$",
                  "minLength": 1,
                  "maxLength": 64
                },
                "type": {
                  "type": "string",
                  "const": "fixEntity"
                },
                "entityId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "description": "Freeze the complete line or circle at its source coordinates and source radius."
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "first",
                "second"
              ],
              "properties": {
                "id": {
                  "type": "string",
