                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$",
                  "minLength": 1,
                  "maxLength": 64
                },
                "secondId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
