  "mcpExample": {
    "method": "run",
    "requestKey": "<fresh host request key>",
    "args": {
      "context": {
        "sessionId": "<live sessionId>",
        "documentId": "<live documentId>",
        "documentInstanceId": "<live documentInstanceId>",
        "expectedRevision": 0
      },
      "idempotencyKey": "<fresh batch key>",
      "steps": [
        {
          "id": "rename",
          "method": "execute",
          "args": {
            "action": "document.rename",
            "args": {
              "name": "示例工程"
            }
          }
        }
      ]
    }
  },
  "transportGuide": "Goldenluck MCP 调用 webcad_submit：method、requestKey、args 在外层；完整 run 请求放在 args 内。外层 requestKey 不会代替 args.idempotencyKey，run 不接受 key 字段；不要把 method、requestKey 或第二层 args 放进 run 请求。页面直接调用 api.run 时只传 args 的内容。替换示例 context 为当前 requestContext，保留两个层次，不自动改写 revision 或重试未知结果。参数拒绝先读 error.details.path/missingFields/allowedFields/commitState，按已读契约修正；不要把报错的简称当成字段，也不要输出全量 index。",
  "docs": "api.run",
  "minimalExample": {
    "context": {
      "sessionId": "<live sessionId>",
      "documentId": "<live documentId>",
      "documentInstanceId": "<live documentInstanceId>",
      "expectedRevision": 0
    },
    "idempotencyKey": "<fresh unique key>",
    "steps": [
      {
        "id": "ring",
        "method": "add",
        "args": {
          "op": "torus",
          "params": {
            "majorRadius": 15,
            "minorRadius": 2.5
          }
        }
      },
      {
        "id": "size",
        "method": "measure",
        "args": {
          "bodyId": {
            "$ref": "ring.createdBodyIds.0"
          }
        }
      }
    ]
  },
  "exampleInstructions": "替换完整 context 为本页最新 requestContext，幂等键为本次新请求生成；不要沿用示例 revision=0。先读取 torus/measure 完整卡。世界坐标、局部坐标及 relative/absolute 以对应工具卡和 placement 为准；居中实体不能假定从0开始，先读真实 bounds/center。",
  "executeExample": {
    "id": "rename",
    "method": "execute",
    "args": {
      "action": "document.rename",
      "args": {
        "name": "示例工程"
      }
    }
  },
  "description": "run({context,idempotencyKey,steps}); 每步必须有唯一 id 和 method，可选 args/stage。add.args 只接受 op/params/refs/name/placement，不接受 opVersion/schemaHash；版本字段由页面补充。执行前必须 readDocs({docId:\"api.run\"}) 并读取所用操作完整卡；本卡概览不替代完整执行契约。addMany 的原子计划见 api.feature-plan。",
  "synonyms": [
    "run",
    "批量",
    "AI",
    "JSON",
    "指令",
    "无CLI"
  ],
  "inputContract": "run({context,idempotencyKey,steps}); 每步必须有唯一 id 和 method，可选 args/stage。add.args 只接受 op/params/refs/name/placement，不接受 opVersion/schemaHash；版本字段由页面补充。执行前必须 readDocs({docId:\"api.run\"}) 并读取所用操作完整卡；本卡概览不替代完整执行契约。addMany 的原子计划见 api.feature-plan。",
  "outputContract": "completed/partial/failed/unknown、逐步回执、progress/recovery、elapsedMs、回执时的 context/requestContext/summary/display；atomic=false。后续操作前核对实时状态。",
  "implementationStatus": "implemented",
  "contractStatus": "page-method",
  "runtimeAvailability": "requires_page",
  "errorModel": "completed/partial/failed/unknown; atomic=false; inspect per-step results and displayMatchesContext. Earlier committed steps remain on failure.",
  "errorCodes": [
    "PARAM_SCHEMA_INVALID",
    "RESOURCE_LIMIT",
    "INSTANCE_MISMATCH",
    "REVISION_CONFLICT",
    "IDEMPOTENCY_KEY_REUSED",
    "STALE_REFERENCE",
    "SIZE_LIMIT"
  ],
  "documentLimits": {
    "maxFeatures": 2000,
    "maxBytes": 104857600,
    "preflightReserveBytes": 4096
  },
  "additionalDocs": [
    "api.state-facts",
    "api.evidence"
  ],
  "selectionGuide": {
    "groupId": "dispatch",
    "groupTitle": "执行、批次与异步作业",
    "chooseWhen": "按顺序执行有界批次；非原子，前面成功项保留；错误项按原回执处理。",
    "alternatives": [
      {
        "id": "getBatchReceipt",
        "chooseWhen": "用原 idempotencyKey 和 documentInstanceId 只读查批次回执；不重发几何，不等同 getJob 查询异步作业。"
      },
      {
        "id": "execute",
        "chooseWhen": "提交一个明确 action 的命令；不接收任意脚本。"
      },
      {
        "id": "invoke",
        "chooseWhen": "公开方法的结构化调用封装；不是任意函数/代码执行。"
      },
      {
        "id": "executeText",
        "chooseWhen": "执行受限文本命令语法或 dryRun；不是自然语言建模或 JS。"
      },
      {
        "id": "submit",
        "chooseWhen": "提交一个具有 jobId 的异步页面作业，须追踪原 job。"
      },
      {
        "id": "getJob",
        "chooseWhen": "只读页面异步作业原回执；未知写入先查，不重复提交。"
      },
      {
        "id": "awaitJob",
        "chooseWhen": "等待同一个页面 job 结束；超时返回当前状态，不取消或重提。"
      },
      {
        "id": "waitFor",
        "chooseWhen": "等待指定修订变化或 job 变化；不是持续执行建模。"
      },
      {
        "id": "cancelJob",
        "chooseWhen": "请求取消指定页面作业；是否停止/提交以最终回执为准。"
      }
    ],
    "policy": "Discovery guidance only; compare input geometry, section/path, parameter meaning, result and side effects. Read the chosen full contract. These distinctions do not add execution blockers."
  },
