              "back",
              "left",
              "right"
            ]
          }
        ]
      },
      "point": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "number"
        }
      },
      "intent": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "placement": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "const": 1
          },
          "frame": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "world"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "snapshot"
