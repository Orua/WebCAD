                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    }
                  },
                  "quaternion": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "number"
                    },
                    "description": "Normalized quaternion [x,y,z,w]; runtime verifies unit length."
                  }
                },
                "required": [
                  "kind",
                  "origin",
                  "quaternion"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "work"
                  },
                  "expectedFrameVersion": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "kind",
                  "expectedFrameVersion"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "saved"
                  },
                  "frameId": {
                    "type": "string",
                    "minLength": 1
