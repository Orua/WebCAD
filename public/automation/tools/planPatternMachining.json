              "reviewedVectors",
              "rasterArtwork",
              "authoredHeightMap",
              "shadedReference",
              "sculptMesh"
            ]
          },
          "userIntentEvidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "sourceHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "direction": {
            "type": "string",
            "enum": [
              "emboss",
              "engrave"
            ]
          },
          "dimensionsMm": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width",
              "height"
            ],
            "properties": {
              "width": {
                "type": "number",
