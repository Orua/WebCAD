                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "quaternion": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        }
