              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100000
            }
          },
          "targetPeakMm": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100000
          },
          "preserve": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
