                "maximum": 100000
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100000
              }
            }
          },
          "specifiedDepthsMm": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100000
            }
          },
          "targetPeakMm": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100000
          },
          "preserve": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "supportBinding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bodyId",
              "geometryFingerprint"
