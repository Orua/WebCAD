                  "unit": "1",
                  "quantityKind": "direction",
                  "quantizationPolicy": "none"
                },
                "widthDirection": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                }
              }
            },
            "profile": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "widthMm",
                    "depthMm"
                  ],
                  "properties": {
                    "kind": {
                      "const": "ellipse"
                    },
                    "widthMm": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "unit": "mm",
                      "quantityKind": "length",
                      "quantizationPolicy": "none"
                    },
                    "depthMm": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "unit": "mm",
                      "quantityKind": "length",
                      "quantizationPolicy": "none"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "edges"
                  ],
                  "properties": {
                    "kind": {
                      "const": "quad"
                    },
                    "edges": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": "array",
                        "minItems": 4,
                        "maxItems": 4,
                        "items": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 2,
                          "items": {
                            "type": "number"
                          }
                        }
                      }
                    }
