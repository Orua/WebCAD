          "properties": {
            "role": {
              "type": "string",
              "enum": [
                "dorsal",
                "ventral",
                "lateral"
              ]
            },
            "pointsMm": {
              "type": "array",
              "minItems": 2,
              "maxItems": 32,
              "items": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        }
      },
      "startCondition": {
        "type": "string",
        "enum": [
          "G0",
          "G1",
          "G2"
        ]
      },
      "endCondition": {
        "type": "string",
        "enum": [
          "G0",
          "G1",
          "G2"
        ]
      },
