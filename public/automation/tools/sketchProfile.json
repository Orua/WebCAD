              "maxLength": 64
            },
            "type": {
              "type": "string",
              "description": "Analytic entity",
              "enum": [
                "line",
                "arc3",
                "circle",
                "rectangle",
                "roundedRectangle",
                "capsule"
              ]
            },
            "originMm": {
              "type": "array",
              "items": {
                "type": "number",
                "unit": "mm",
