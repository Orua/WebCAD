                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "minItems": 4,
              "maxItems": 4
            }
          },
          "creases": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "edge",
                "sharpness"
              ],
              "properties": {
                "edge": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  }
                },
                "sharpness": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      },
      "brushes": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "centerMm",
            "radiusMm",
            "strength"
          ],
          "properties": {
            "centerMm": {
              "type": "array",
              "items": {
                "type": "number",
                "unit": "mm",
                "quantityKind": "length",
                "quantizationPolicy": "none"
              },
              "minItems": 3,
              "maxItems": 3,
              "unit": "mm",
              "quantityKind": "length",
              "quantizationPolicy": "none"
            },
            "radiusMm": {
              "type": "number",
              "exclusiveMinimum": 0,
              "unit": "mm",
              "quantityKind": "length",
              "quantizationPolicy": "none"
            },
            "strength": {
              "type": "number",
              "description": "push/inflate: signed maximum control-vertex displacement in mm, weighted by falloff; smooth: dimensionless interpolation factor in [0,1]. Brushes affect cage vertices, not the refined surface."
            },
            "mode": {
              "type": "string",
              "enum": [
                "push",
                "smooth",
                "inflate"
              ]
            },
            "falloff": {
              "type": "string",
              "enum": [
                "smooth",
                "linear"
              ]
            }
          }
        }
      },
